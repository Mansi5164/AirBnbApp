	<groupId>com.coding.shuttle</groupId>
	<artifactId>airBnb-App</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>airBnb-App</name>
	<description>Airbnb clone project for Spring Boot</description>
	<url/>
	<licenses>
		<license/>
